<div class="tl-recap-form-body">
  <div class="form-group">
    <label>{{localize "TABLE_LEDGER.Recap.Form.Session"}}</label>
    <input type="number" name="session" value="{{session}}" min="0" step="1" required>
  </div>
  <div class="form-group">
    <label>{{localize "TABLE_LEDGER.Recap.Form.RecapTitle"}}</label>
    <input type="text" name="title" required>
  </div>
  <div class="form-group">
    <label>{{localize "TABLE_LEDGER.Recap.Form.Date"}}</label>
    <input type="text" name="date" placeholder="2026-11-11">
  </div>
  <div class="form-group stacked">
    <label>{{localize "TABLE_LEDGER.Recap.Form.Body"}}</label>
    <textarea name="body" rows="12" required></textarea>
    <p class="hint">{{localize "TABLE_LEDGER.Recap.Form.BodyHint"}}</p>
  </div>
  <footer class="form-footer">
    <button type="submit"><i class="fa-solid fa-paper-plane"></i> {{localize "TABLE_LEDGER.Recap.Form.Post"}}</button>
  </footer>
</div>
