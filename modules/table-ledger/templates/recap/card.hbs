<div class="tl-recap-card">
  <header class="tl-recap-card-header">
    <i class="fa-solid fa-scroll"></i>
    <span class="tl-recap-card-session">{{heading}}</span>
    {{#if date}}<span class="tl-recap-card-date">{{date}}</span>{{/if}}
  </header>
  <h3 class="tl-recap-card-title">{{title}}</h3>
  {{#if excerpt}}<p class="tl-recap-card-excerpt">{{excerpt}}</p>{{/if}}
  <p class="tl-recap-card-link">{{link}}</p>
</div>
